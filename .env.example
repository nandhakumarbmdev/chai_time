PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/break_buddy?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173,https://yuvi-labs-chai-time.netlify.app
CUTOFF_TIME=19:00
BREAK_TIME=15:30
TZ=Asia/Kolkata

# ── Autonomous dev agent (off unless enabled; needs the `claude` CLI + ANTHROPIC_API_KEY on the host) ──
DEV_AGENT_ENABLED=false
# main = push to main after checks pass (Render deploys) | branch = push dev/<id> only | off = commit locally only
DEV_DEPLOY=main
# ADMIN_KEY=            # optional: if set, /api/dev/* and the socket stream require it
# DEV_JOB_TIMEOUT_MIN=15
# DEV_MAX_BUDGET_USD=2
# DEV_GIT_CREDENTIAL_HELPER=!gh auth git-credential   # how pushes authenticate; 'none' = git's own config
