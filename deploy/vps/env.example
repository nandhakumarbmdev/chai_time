# Copy to /etc/chai-dev-agent.env (setup.sh does this), chmod 600, then fill in the blanks.
# Values are literal: no quotes, no $VAR expansion by systemd.

PORT=4000
TZ=Asia/Kolkata

# Same database the app uses (the agent itself never sees this: it is stripped from the agent's environment)
MONGODB_URI=
# Browser origins allowed to call this server (your Netlify site, plus localhost for testing)
CLIENT_ORIGIN=https://yuvi-labs-chai-time.netlify.app,http://localhost:5174
CUTOFF_TIME=19:00
BREAK_TIME=15:30

# ── Dev agent ──
DEV_AGENT_ENABLED=true
# branch = push dev/<id> and merge yourself | main = push straight to main (Render deploys) | off
DEV_DEPLOY=branch
DEV_WORK_DIR=/var/lib/chai-dev/jobs
# Required: anyone who can reach this server can otherwise queue jobs. setup.sh fills it in.
ADMIN_KEY=
# Claude login for the agent
ANTHROPIC_API_KEY=
# GitHub fine-grained token: this repo only, Contents = Read and write
GITHUB_TOKEN=
DEV_GIT_CREDENTIAL_HELPER=!f() { echo username=x-access-token; echo password=$GITHUB_TOKEN; }; f
